    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "memtory",
      "version": "0.1.0",
      "packageArguments": [
        { "type": "positional", "value": "mcp" }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
