{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.memtory/memtory",
  "title": "Memtory",
  "description": "Project manager for AI coding agents: roadmap, backlog and decision log for your repo.",
  "version": "0.1.0",
  "websiteUrl": "https://memtory.com",
  "repository": {
