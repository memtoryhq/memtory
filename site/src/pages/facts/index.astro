---
import Base from '../../layouts/Base.astro';
import { facts, inline } from '../../lib/facts';
import { pages } from '../../lib/pages';
---

<Base
  title={pages.facts.title}
  breadcrumbs={[{ name: 'Facts', path: pages.facts.path }]}
  description={pages.facts.description}
>
  <article class="prose">
    <h1>{facts.title} facts</h1>
    <p class="lead" set:html={inline(facts.definition)} />
    <p class="meta">
      Updated <time datetime={facts.updated}>{facts.updated}</time>.
      {facts.status && <span> {facts.status}</span>}
    </p>
    {
      facts.sections.map((s) => (
        <section>
          <h2>{s.heading}</h2>
          <ul>
            {s.items.map((item) => (
              <li set:html={inline(item)} />
            ))}
          </ul>
        </section>
      ))
    }
    <p class="meta">
      Also available as plain text: <code>npx memtory</code>, or the <code>memtory_about</code> MCP tool.
    </p>
  </article>
</Base>
